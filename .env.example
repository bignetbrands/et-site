# ============================================================
# ET BOT — Environment Variables
# ============================================================
# Copy this to .env.local for local development.
# Add all of these to Vercel Environment Variables for production.
# ============================================================

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- OpenAI (DALL-E for lore images) ---
OPENAI_API_KEY=sk-xxxxx

# --- X/Twitter API (OAuth 1.0a User Context) ---
# Get these from developer.x.com → your app → Keys and Tokens
X_API_KEY=xxxxx
X_API_SECRET=xxxxx
X_ACCESS_TOKEN=xxxxx
X_ACCESS_SECRET=xxxxx

# --- Vercel KV (Redis — for state tracking) ---
# These are auto-populated when you connect Vercel KV in your project.
# For local dev, copy from Vercel dashboard → Storage → KV → .env.local
KV_URL=xxxxx
KV_REST_API_URL=xxxxx
KV_REST_API_TOKEN=xxxxx
KV_REST_API_READ_ONLY_TOKEN=xxxxx

# --- Security ---
# Random string to protect the cron endpoint. Set this in Vercel.
# Vercel auto-sends this as Authorization header for cron jobs.
CRON_SECRET=generate-a-random-string-here

# Random string to protect admin/manual endpoints.
ADMIN_SECRET=generate-a-different-random-string-here

# --- Quantum Oracle (RNG Payment Gate) ---
# Solana RPC — server-side (use your Helius URL)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=xxxxx
# Solana RPC — client-side (same Helius URL, exposed to browser)
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=xxxxx
# The $ET pump.fun tokenized agent mint address
AGENT_TOKEN_MINT_ADDRESS=A1NZ4kjhJxdmMMHQTGF8HaU7k6JCch5gSyHEeAKE3xRMF
# Wrapped SOL mint (payment currency)
CURRENCY_MINT=So11111111111111111111111111111111111111112

# --- ET Autonomous Wallet ---
# ET's Solana wallet private key (base58 encoded) for autonomous SOL reward payments
# Fund this wallet with enough SOL for task rewards (0.05-0.1 SOL each)
# Generate a new keypair: solana-keygen new --outfile et-wallet.json
# Get base58 key: cat et-wallet.json | python3 -c "import json,sys,base58; k=json.load(sys.stdin); print(base58.b58encode(bytes(k)).decode())"
ET_WALLET_PRIVATE_KEY=your-base58-private-key-here
